#include <stdio.h>

int main() {
    int a, b, c, car;

    scanf("%d %d %d %d", &a, &b, &c, &car);

    if (car % 3 == 1)
        printf("Car 1 goes into road A");
    else if (car % 3 == 2)
        printf("Car 1 goes into road B");
    else if (car % 3 == 0)
        printf("Car 1 goes into road C");
    else
        printf("No path exists");

    return 0;
}
